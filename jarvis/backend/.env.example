# JARVIS backend configuration
# Copy this file to .env and fill in values locally/on your server.
# NEVER commit your real .env file or paste secrets into GitHub.

# Required for the API to start. Generate with: python -m app.make_secrets
JWT_SECRET=replace_with_generated_random_secret_at_least_32_characters
ADMIN_PASSWORD_HASH=replace_with_generated_scrypt_hash
WEBHOOK_SECRET=replace_with_generated_random_webhook_secret

# Your own mobile number in E.164 format, e.g. +91XXXXXXXXXX
APPROVED_NUMBER=+91XXXXXXXXXX

# Public HTTPS base URL of your deployed JARVIS server (no trailing slash)
PUBLIC_BASE_URL=https://your-domain.example

# Keep disabled during all development and testing.
CALLS_ENABLED=false

# Exotel credentials (leave blank until account setup is complete)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_HOST=api.in.exotel.com
EXOTEL_CALLER_ID=

# OpenAI Realtime API key (leave blank until configured)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=cedar

# Safety limits
MAX_CALL_SECONDS=600
CALL_COOLDOWN_SECONDS=120
MAX_CALLS_PER_DAY=10
DELAYED_CALL_SECONDS=180

# Local persistent database path inside the backend container
DB_PATH=./data/jarvis.db
